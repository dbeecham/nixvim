snippet sigprocmask "sigprocmask()" b
	ret = sigprocmask(
		/* how = */ SIG_BLOCK,
		/* set = */ ${1:&`!lua require('local').name()`->sigset}, 
		/* old = */ NULL
	);
	if (-1 == ret) {
		syslog(LOG_ERR, "%s:%d:%s: sigprocmask: %s", __FILE__, __LINE__, __func__, strerror(errno));
		return -1;
