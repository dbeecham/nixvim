				.iov_base = ${2:buf},
				.iov_len = ${3:buf_len}
			}${4}
		},
		/* iovecs_len = */ ${5:1}
	);
	if (-1 == ret) {
		syslog(LOG_ERR, "%s:%d:%s: readv: %s", __FILE__, __LINE__, __func__, strerror(errno));
		return -1;
	}
	${0}
snippet writev "writev()" b
	ret = writev(
		/* fd = */ ${1:fd},
