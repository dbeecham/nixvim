snippet sqlite3_open_v2 "sqlite3_open_v2" b
	// useful flags: SQLITE_OPEN_READONLY, SQLITE_OPEN_READWRITE, SQLITE_OPEN_CREATE, SQLITE_OPEN_MEMORY
	ret = sqlite3_open_v2(
		/* path = */ ${1:"db.sqlite"},
		/* db = */ &${2:db},
		/* flags = */ ${3:SQLITE_OPEN_READWRITE},
		/* vfs = */ NULL
	);
	if (SQLITE_OK != ret) {
		syslog(LOG_ERR, "%s:%d:%s: sqlite3_open_v2 returned %d: %s", __FILE__, __LINE__, __func__, ret, sqlite3_errmsg($2));
		return -1;
	}
	${0}
