	if (-1 == ret) {
		syslog(LOG_ERR, "%s:%d:%s: writev: %s", __FILE__, __LINE__, __func__, strerror(errno));
		return -1;
	}
	${0}
snippet mount "mount()" b
	ret = mount(
		/* src = */ ${1:"proc"},
		/* dest = */ ${2:"/proc"},
		/* type = */ ${3:"proc"},
		/* mountoptions = */ ${4:MS_NOATIME},
		/* fsoptions = */ ${5:NULL}
	);
	if (-1 == ret) {
