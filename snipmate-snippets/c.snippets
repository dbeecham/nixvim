		if (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR) {
			// re-arm fd on epoll and try again
		}
		syslog(LOG_ERR, "%s:%d:%s: accept: %s", __FILE__, __LINE__, __func__, strerror(errno));
