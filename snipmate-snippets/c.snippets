# stubs {{{
snippet inc "#include <...>" b
	#include <${1:stdio.h}>${2}
snippet main "int main() { ... }" b
	int main (
		int argc,
		char const * argv[]
	)
	{
		int ret = 0;

		${0}

		return 0;
	}
snippet f "int f() { ... }" b
	${1:int} ${2:`!lua require('local').name()`}${3:_init} (
		${4:struct `!lua require('local').name()`_s * `!lua require('local').name()`}${5}
	)
	{
		int ret = 0;

		${0}

		return 0;
	}
snippet F "ret = f(x)" b
	${1:ret} = ${2:f}(${3:struct app_s * app});
	${4}
snippet struct "struct {}" b
	struct ${1:`!lua require('local').name()`}_s {
		uint8_t sentinel;
		${0}
	};
snippet enum "enum" b
	enum ${1:`!lua require('local').name()`_epoll_type_e} {
		${0}
	};
# }}}
# Control flow {{{
snippet if "if" b
	if (${1:-1 == ret}) {
		${0}
	}
snippet else "else" b
	else {
		${0}
	}
snippet elif "else if" b
	else if (${1:1 == ret}) {
		${0}
	}
snippet exit "exit(EXIT_FAILURE);" b
	exit(EXIT_FAILURE);
snippet for "for () {}" b
	for (${1:int} ${2:i} = ${3:0}; $2 < ${4:len}; $2++) {
		${0}
	}
snippet fori "for (int i = 0; i < len; i++) {}" b
	for (int i = 0; i < ${1:len}; i++) {
		${0}
	}
snippet forri "for (int i = max; ...; i--) {}" b
	for (int ${1:i} = ${2:len}; $1 >= 0; $1--) {
		${0}
	}
snippet while "while () {}" b
	while (${1}) {
		${0}
	}
snippet switch "switch" b
	switch (${1}) {
		case ${2:val}:
			${0}
			break;
	}
snippet case "case: break;" b
	case ${1}:
		${0}
		break;
# }}}
# Logging {{{
snippet openlog "openlog()" b
	#   ifdef CONFIG_SYSLOG_PERROR
			openlog("${1:`!lua require('local').name()`}", LOG_PERROR | LOG_NDELAY | LOG_PID, LOG_USER);
	#   else
			openlog("$1", LOG_CONS | LOG_NDELAY | LOG_PID, LOG_USER);
	#   endif
	${0}
snippet perr "fprintf(stderr, ..." b
	fprintf(stderr, "%s:%d:%s: ${1:hi!}\n", __FILE__, __LINE__, __func__${2});${3}
snippet err "syslog(LOG_ERR, ..." b
	syslog(LOG_ERR, "%s:%d:%s: ${1:msg}", __FILE__, __LINE__, __func__${2});${0}
snippet warn "syslog(LOG_WARN, ..." b
	syslog(LOG_WARNING, "%s:%d:%s: ${1:msg}", __FILE__, __LINE__, __func__${2});${0}
snippet info "syslog(LOG_INFO, ..." b
	syslog(LOG_INFO, "%s:%d:%s: ${1:msg}", __FILE__, __LINE__, __func__${2});${0}
snippet debug "syslog(LOG_DEBUG, ..." b
	syslog(LOG_DEBUG, "%s:%d:%s: ${1:msg}", __FILE__, __LINE__, __func__${2});${0}
snippet hi "syslog(hi!)" b
	syslog(LOG_DEBUG, "%s:%d:%s: hi!", __FILE__, __LINE__, __func__);${0}
snippet strerror "strerror(errno)" w
	strerror(${1:errno})${0}
snippet snprintf "snprintf()" b
	bytes_written = snprintf(${1:buf}, ${2:buf_len}, "${3}"${4});
	if (-1 == bytes_written) {
		syslog(LOG_WARNING, "%s:%d:%s: snprintf: %s", __FILE__, __LINE__, __func__, strerror(errno));
		return -1;
	}
	${0}
snippet printf "printf(...)" b
	printf("%s:%d:%s: ${1}\n", __FILE__, __LINE__, __func__${2});${0}
snippet fprintf "fprintf(...)" b
	fprintf(${1:stderr}, "${2}\n"${3});${0}
# }}}
# stdc {{{
snippet memcpy
	memcpy(${1:dest}, ${2:src}, ${3:src_len});${0}
snippet malloc "malloc()"
	malloc(${1});${0}
snippet calloc
	calloc(${${1:sizeof(struct foo)}, ${2:1});${0}
snippet sizeof
	sizeof(${1})${0}
snippet realloc "" b
	realloc(${1:old}, ${2:num_members} * sizeof(${3:type}));${0}
snippet seed_rand "" b
	srand(time(NULL));${0}
snippet bsearch "" b
	// A needle to search for in the haystack; needs to be able to be compared
	// to items in the key-value list using the compare function (bsearch_cmp).
	struct ${1:item_s} key = {"${2:key}", 0};
	struct $1 * needle = bsearch(
		/* key = */ &key,
		/* haystack = */ ${3:`!lua require('local').name()`->kv}, 
		/* haystack_len = */ ${4:$3_len},
		/* item size = */ ${5:sizeof(*$3)},
		/* cmp_cb = */ ${6:`!lua require('local').name()`_cmp}
	);
	if (NULL == needle) {
		syslog(LOG_INFO, "%s:%d:%s: item not found", __FILE__, __LINE__, __func__);
		return -1;
	}
	${0}
snippet static_assert "" b
	static_assert(${1:condition}, ${2:message});
snippet va_list "" b
	va_list ${1:ap};
	va_start($1, ${2:LAST_ARG});
	${0}
	va_end($1);
# }}}
# syscalls {{{
snippet read "read(fd, buf, len)" b
	bytes_read = read(${1:fd}, ${2:buf}, ${3:buf_len});
	if (-1 == bytes_read) {
		syslog(LOG_ERR, "%s:%d:%s: read: %s", __FILE__, __LINE__, __func__, strerror(errno));
		return -1;
	}
	if (0 == bytes_read) {
		${4}
	}
	${0}
snippet close "close(fd)" b
	ret = close(${1:fd});
	if (-1 == ret) {
		syslog(LOG_ERR, "%s:%d:%s: close: %s", __FILE__, __LINE__, __func__, strerror(errno));
		return -1;
	}
	${0}
snippet exit "exit(EXIT_FAILURE)" b
	exit(EXIT_FAILURE);
