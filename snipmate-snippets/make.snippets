snippet vars "standard variables" b
	# include .config configuration (kconfig); no error if file does not exist.
	-include .config


	#########################################
	# VARIABLES - overridable by make flags #
	#########################################
	CFLAGS         = 
	cflags-y       = $(CFLAGS) $(EXTRA_CFLAGS)
	cflags-y      += -std=c11 -Wall -Wextra -Wno-implicit-fallthrough -Wno-unused-const-variable
	cflags-y      += -Werror=format-security -Werror=implicit-function-declaration 
	cflags-y      += -Wshadow -Wdouble-promotion -Wformat=2 -Wformat-truncation -Wvla 
	cflags-y      += -Wno-unused-parameter -fno-common -Wno-unused-function
	cflags-y      += -pipe
	LDFLAGS        = 
	ldflags-y      = $(LDFLAGS) $(EXTRA_LDFLAGS)
	ldflags-y     += -fno-common 
	LDLIBS         = 
	ldlibs-y       = $(LDLIBS) $(EXTRA_LDLIBS)
	DESTDIR        = /
	PREFIX         = /usr/local
	RAGEL          = ragel
	RAGELFLAGS     = -G2 $(EXTRA_RAGELFLAGS)
	INSTALL        = install
	BEAR           = bear
	COMPLEXITY     = complexity
	CFLOW          = cflow
	SED            = sed
	TAR            = tar
	NEATO          = neato
	CTAGS          = ctags
	UPX            = upx
	STRIP          = strip
	SCAN_BUILD     = scan-build
	DOCKER         = docker
	KCONFIG_MCONF  = kconfig-mconf
	KCONFIG_NCONF  = kconfig-nconf
	KCONFIG_CONF   = kconfig-conf
	Q              = @
	CC_COLOR       = \033[0;34m
	LD_COLOR       = \033[0;33m
	TEST_COLOR     = \033[0;35m
	INSTALL_COLOR  = \033[0;32m
	NO_COLOR       = \033[m
	${0}
snippet main "main target"
	default: all

	all: ${1:app}

	$1: $1.o
	${0}
snippet docker-build "docker build" b
	context-y = Dockerfile package.json package-lock.json
	context-y += app.js

	.PHONY: docker-build
	docker-build: $(context-y)
		@printf "$(CC_COLOR)CC$(NO_COLOR) $@\n"
		$(Q)$(TAR) -c $(context-y) | $(DOCKER) build --tag app --network host -

	${0}
snippet vpath "vpaths" b
	vpath %.c src/
	vpath %.h src/
	vpath %.c include/
	vpath test_%.c tests/
